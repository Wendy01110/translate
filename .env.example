# 这是变量清单示例，不是运行中的配置。程序只读一个文件：AI_TRANSLATE_ENV_FILE > 项目 .env > ~/Library/Application Support/AI Translate/.env。设置页不会写入本文件。
# 翻译。与 OCR 配置完全独立，不得互相借用。
# provider：默认 google_web。google_web / bing_web / deepl_web 为免密钥内置源；openai / deepl / microsoft / google 为官方或兼容接口。
TRANSLATE_PROVIDER=google_web
TRANSLATE_BASE_URL=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=
TRANSLATE_REGION=
# 设置页翻译模型列表，逗号分隔。当前 TRANSLATE_MODEL 会自动出现在列表里。
TRANSLATE_MODELS=
TRANSLATE_TIMEOUT_SECONDS=30
TRANSLATE_SOURCE_LANG=auto
TRANSLATE_TARGET_LANG=zh

# OCR。engine=auto 时先用本机 Vision，不够再走模型。
OCR_ENGINE=auto
OCR_MIN_CONFIDENCE=0.5
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=Unlimited-OCR
# 设置页 OCR 模型列表，逗号分隔。当前 OCR_MODEL 会自动出现在列表里。
OCR_MODELS=
OCR_TIMEOUT_SECONDS=180
OCR_MAX_TOKENS=24000
OCR_IMAGE_MODE=

# macOS 热键。修饰键：alt/option、ctrl、shift、cmd。
HOTKEY_SELECTION=alt+e
HOTKEY_OCR=alt+w
