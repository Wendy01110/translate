# 这是变量清单示例，不是运行中的配置。程序只读一个文件：AI_TRANSLATE_ENV_FILE > 项目 .env > 用户配置目录。macOS 用户目录是 ~/Library/Application Support/AI Translate/.env，Windows 是 %APPDATA%\AI Translate\.env。设置页不会写入本文件。
# 翻译。与 OCR 配置完全独立，不得互相借用。
# provider：默认 google_web。google_web / bing_web / deepl_web 为免密钥内置源；openai / deepl / microsoft / google 为官方或兼容接口。
# 本机 llm-token-router 示例：provider=openai、base_url=http://127.0.0.1:8000/v1、model=auto；当前本地网关不校验调用方密钥时可留空。
TRANSLATE_PROVIDER=google_web
TRANSLATE_BASE_URL=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=
# 可选的 llm-token-router 私有开关。使用默认本机地址时即使省略也会关闭思考；自定义 Router 地址可显式设为 false，设为 true 才开启。
# TRANSLATE_ROUTER_THINKING=false
TRANSLATE_REGION=
# 设置页翻译模型列表，逗号分隔。当前 TRANSLATE_MODEL 会自动出现在列表里。
TRANSLATE_MODELS=
TRANSLATE_TIMEOUT_SECONDS=30
TRANSLATE_SOURCE_LANG=auto
TRANSLATE_TARGET_LANG=zh

# OCR 四层分流。auto：本地普通 -> 本地高级 -> API 普通 -> API 高级。vision=只本地普通，paddle=只本地高级，standard=只 API 普通，model=只 API 高级。
# 固定图片预算：每次最多 10 页，单张与全部原始图片合计均最多 20 MiB；不由环境变量调整。API 普通仍另受单张 1 MB 限制。
OCR_ENGINE=auto
OCR_MIN_CONFIDENCE=0.5

# 本地高级 OCR：可选 PP-OCRv6。默认 tiny，优先降低本地时延；也可切换 small 或 medium；当前只支持 CPU。
OCR_LOCAL_ADVANCED_MODEL_TIER=tiny
OCR_LOCAL_ADVANCED_DEVICE=cpu

# API 普通 OCR：OCR.space 免费接口，默认 Engine 2。普通和高级配置不得互相借用。
OCR_STANDARD_BASE_URL=https://api.ocr.space/parse/image
OCR_STANDARD_API_KEY=
OCR_STANDARD_TIMEOUT_SECONDS=30
OCR_STANDARD_ENGINE=2
OCR_STANDARD_LANGUAGE=auto

# API 高级 OCR：OpenAI 兼容视觉模型配置。Unlimited-OCR 使用其专用请求合同；其它模型使用标准 image_url 消息，可把本机 llm-token-router 的地址和视觉模型填在这里。
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=Unlimited-OCR
# 可选的 llm-token-router 私有开关。使用默认本机地址时即使省略也会关闭思考；连接其它 OpenAI 兼容服务时不要设置。
# OCR_ROUTER_THINKING=false
# 设置页 OCR 模型列表，逗号分隔。当前 OCR_MODEL 会自动出现在列表里。
OCR_MODELS=
OCR_TIMEOUT_SECONDS=180
OCR_MAX_TOKENS=24000
OCR_IMAGE_MODE=

# 桌面热键。macOS 修饰键：alt/option、ctrl、shift、cmd；Windows 使用 alt、ctrl、shift、cmd/win。
HOTKEY_SELECTION=alt+e
HOTKEY_OCR=alt+w
HOTKEY_LIVE_OCR=alt+q
